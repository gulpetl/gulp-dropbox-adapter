{
  "name": "@gulpred/dropbox-adapter",
  "version": "0.0.3",
  "repository": "https://github.com/gulpetl/gulp-dropbox-adapter",
  "description": "Upload/download files to/from DropBox",
  "type": "module",
  "exports": {
    "types": "./esm/plugin.d.ts",
    "import": "./esm/plugin.js",
    "require": "./cjs/plugin.js"
  },
  "main": "cjs/plugin.js",
  "typings": "cjs/plugin.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm compile && pnpm compile-commonjs",
    "compile": "tsc --module ES2022 --outDir esm/ && echo {\"type\": \"module\"} > esm/package.json",
    "compile-commonjs": "tsc --module commonjs --outDir cjs/ --declarationDir cjs/ && echo {\"type\": \"commonjs\"} > cjs/package.json",
    "clean": "rimraf esm/* --glob && rimraf cjs/* --glob",
    "test": "vitest",
    "bump": "npm version patch && git push --tags origin master"
  },
  "author": "peterl@sbcotton.com",
  "license": "MIT",
  "engines": {
    "node": ">=0.10.0"
  },
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "dropbox.src": "dropbox_src.js",
      "dropbox.dest": "dropbox_dest.js"
    }
  },
  "keywords": [
    "dropbox",
    "gulpfriendly",
    "vinyl",
    "gulp",
    "gulpfriendly",
    "gulp-etl",
    "gulpetl",
    "etl",
    "node-red"
  ],
  "homepage": "https://gulpetl.com",
  "dependencies": {
    "dropbox": "^10.34.0",
    "from2": "^2.3.0",
    "gulp-error-handle": "^1.0.1",
    "loglevel": "^1.9.1",
    "merge": "^2.1.1",
    "pkginfo": "^0.4.1",
    "plugin-error": "^2.0.1",
    "request": "^2.88.2",
    "rimraf": "^6.0.1",
    "stream-combiner": "^0.2.2",
    "through2": "^4.0.2",
    "vinyl": "^3.0.0"
  },
  "devDependencies": {
    "@types/from2": "^2.3.5",
    "@types/node": "^18.19.45",
    "@types/request": "^2.48.12",
    "@types/through2": "^2.0.41",
    "@types/vinyl": "^2.0.12",
    "gulp": "^4.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
